<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Android 9+ blocks plain HTTP by default. The local dev backend (docker compose,
         no TLS) is only ever reached from debug builds - this merges into the debug
         manifest only, so release builds stay HTTPS-only unless someone deliberately
         adds this there too. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
